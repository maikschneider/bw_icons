#!/usr/bin/env bash
# shellcheck disable=SC2086
set -e

## Description: Initialize TYPO3 installation
## Usage: init-typo3
## Example: ddev init-typo3

readonly dbHost="db"
readonly dbUser="db"
readonly dbPassword="db"
readonly dbName="db"
readonly dbCredentials="-h${dbHost} -u${dbUser} -p${dbPassword}"
readonly fixturePath="/var/www/html/Tests/Fixtures"
readonly typo3Binary="/var/www/html/vendor/bin/typo3"
readonly typo3cmsBinary="/var/www/html/vendor/bin/typo3cms"

function _progress() {
    printf "%s... " "$1"
}

function _done() {
    printf "\e[32mDone\e[39m\n"
}

# Create empty database
_progress "Creating empty database"
mysql -Nse "SHOW TABLES" $dbCredentials "$dbName" | while read -r table; do
    mysql -e "DROP TABLE ${table}" $dbCredentials "$dbName"
done
_done

# Prepare setup environment
export TYPO3_DB_DRIVER=mysqli
export TYPO3_DB_USERNAME="$dbUser"
export TYPO3_DB_PASSWORD="$dbPassword"
export TYPO3_DB_PORT=3306
export TYPO3_DB_HOST="$dbHost"
export TYPO3_DB_DBNAME="$dbName"
export TYPO3_SETUP_ADMIN_EMAIL=admin@example.com
export TYPO3_SETUP_ADMIN_USERNAME=admin
export TYPO3_SETUP_ADMIN_PASSWORD=Passw0rd!
export TYPO3_SERVER_TYPE=other
export TYPO3_PROJECT_NAME="EXT:bw_icons"

# Set up environment
_progress "Setting up TYPO3 installation"
  "$typo3Binary" setup --no-interaction --force --quiet
_done

# The Playwright container has no PHP, so acceptance tests hand extension
# configuration to TYPO3 through a JSON file that additional.php merges in.
_progress "Patching additional.php for acceptance test configuration"
  # Drop a previously appended block first so the patch always matches this script.
  sed -i '\|// BW_ICONS_TEST_CONFIGURATION|,$d' /var/www/html/config/system/additional.php
  cat >> /var/www/html/config/system/additional.php <<'PHP'
// BW_ICONS_TEST_CONFIGURATION
// Lives on the shared ddev volume because the project directory reaches the web
// container through mutagen, which is too laggy to drive a test from.
$bwIconsTestConfiguration = '/mnt/ddev-global-cache/bw-icons-test-configuration.json';
if (getenv('IS_DDEV_PROJECT') === 'true' && file_exists($bwIconsTestConfiguration)) {
    $GLOBALS['TYPO3_CONF_VARS']['EXTENSIONS']['bw_icons'] = array_replace(
        $GLOBALS['TYPO3_CONF_VARS']['EXTENSIONS']['bw_icons'] ?? [],
        (array)json_decode((string)file_get_contents($bwIconsTestConfiguration), true)
    );
    // The tests change TCA-relevant configuration between requests and have no
    // way to flush the file-based code cache, so it is switched off for them.
    $GLOBALS['TYPO3_CONF_VARS']['SYS']['caching']['cacheConfigurations']['core']['backend']
        = \TYPO3\CMS\Core\Cache\Backend\NullBackend::class;
}
PHP
_done

# Set extension configuration
_progress "Setting up configuration"
  "$typo3Binary" configuration:set SYS/trustedHostsPattern '.*.*' --no-interaction --quiet
  "$typo3Binary" cache:flush
_done

# Import DB fixtures
for file in "$fixturePath"/*.sql; do
    _progress "Importing DB fixture \"$(basename "$file")\""
    mysql $dbCredentials "$dbName" < "$file"
    _done
done
